# ============================================================
# Contoh konfigurasi. Salin nilai asli ke file .env (jangan commit .env).
# ============================================================

# Kredensial portal ETHOL
ETHOL_USERNAME=username@student.pens.ac.id
ETHOL_PASSWORD=password_ethol
ETHOL_USERNAME_2=username_cadangan@student.pens.ac.id
ETHOL_PASSWORD_2=password_cadangan

# Grup tujuan notifikasi
TARGET_GROUP_ID=xxxxxxxxxxxxxxxxxx@g.us

# Gemini AI
GEMINI_API_KEY=isi_api_key_gemini
# GEMINI_API_KEYS=key1,key2,key3
# Model utama dan cadangan kalau model utama sedang sibuk (503).
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Kas kelas
KAS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/xxxx/edit
KAS_PAYMENT_INFO="SEABANK:xxxxxxxx atau Shopee 08xxxxxxxxxx"
# Otomatis pilih TAB spreadsheet sesuai semester aktif (mis. semester 3 -> tab
# "Sem 3") supaya rekap/reminder ikut berpindah saat semester berganti.
# Default true. Set false kalau ingin selalu memakai gid pada URL di atas.
KAS_AUTO_SEMESTER=true

# Reminder kas otomatis. Bisa beberapa jadwal sekaligus, pisahkan dengan koma.
# Default: Minggu 19:00 dan Senin 06:00 WIB (zona Asia/Jakarta).
# Set KAS_REMINDER_ENABLED=false untuk mematikan. Format cron node-cron.
KAS_REMINDER_ENABLED=true
KAS_REMINDER_CRON=0 19 * * 0,0 6 * * 1

# ============================================================
# OWNER, BACKUP, DAN ALERT
# ============================================================

# Nomor WhatsApp owner untuk notifikasi error (format internasional tanpa +).
OWNER_NUMBER=6285704682918

# true = kirim alert ke owner kalau bot restart setelah mati mendadak.
ALERT_ON_START=true

# Alert kalau RAM tersisa di bawah nilai ini (MB). 0 = matikan alert RAM.
ALERT_MIN_FREE_MEMORY_MB=120

# Backup otomatis absensi_data.json. Disimpan di folder backups/ (lihat .
# gitignore) dan hanya BACKUP_KEEP file terbaru yang disimpan.
BACKUP_CRON=30 23 * * *
BACKUP_KEEP=21
# BACKUP_DIR=./backups

# ============================================================
# LOGIN WHATSAPP
# ============================================================

# Isi dengan nomor WhatsApp bot dalam format internasional tanpa +, spasi, atau tanda hubung.
# Contoh: 6281234567890
# Jika dikosongkan, bot akan memakai login QR seperti sebelumnya.
PAIRING_NUMBER=

# Kode negara yang dipakai kalau nomor ditulis dengan awalan 0 (mis. 0812...).
PAIRING_COUNTRY_CODE=62

# Folder penyimpanan sesi. Kosongkan untuk memakai ./session.
# SESSION_DIR=./session

# ============================================================
# TOMBOL INTERAKTIF (EKSPERIMENTAL)
# ============================================================

# true = .menu memakai tombol native WhatsApp; false = menu teks biasa.
# Tombol native tidak resmi dan bisa diabaikan WhatsApp. Tes dulu di grup testing.
ENABLE_BUTTONS=false

# Gaya menu saat ENABLE_BUTTONS=true:
# buttons = tombol quick reply bertingkat (lebih aman)
# list    = daftar menu klasik WhatsApp (kompatibel iPhone & Android)
MENU_STYLE=buttons

# Kalau diisi, tombol hanya dikirim di grup ini. Kosongkan untuk semua grup.
BUTTONS_TEST_GROUP_ID=120363424800769453@g.us

# Batasi command bot hanya dari grup tertentu (pisahkan dengan koma).
# - Kosong + SAFE_MODE=true : hanya TARGET_GROUP_ID dan BUTTONS_TEST_GROUP_ID.
# - Kosong + SAFE_MODE=false: semua grup diizinkan.
# - Ada isi                 : hanya grup yang ditulis di sini.
# Contoh: COMMAND_ALLOWED_GROUPS=120363418765506558@g.us,120363424800769453@g.us
COMMAND_ALLOWED_GROUPS=

# Tambahan grup yang selalu diabaikan, walaupun ada di allowlist.
# Grup 120363318879953960@g.us sudah diblokir permanen oleh kode (pemicu writer timeout).
COMMAND_BLOCKED_GROUPS=120363318879953960@g.us

# ============================================================
# DEBUG & PUPPETEER
# ============================================================

# Tampilkan log setiap pesan masuk (berguna saat bot tidak membalas).
DEBUG_MESSAGES=false

# Batas waktu membuka Chromium (milidetik).
PUPPETEER_LAUNCH_TIMEOUT=60000
PUPPETEER_PROTOCOL_TIMEOUT=120000

# Opsional: pakai Chrome sistem, bukan Chrome bawaan Puppeteer.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Jeda sebelum pengecekan portal pertama dan sinkronisasi ETHOL saat bot baru connect.
PORTAL_START_DELAY_MS=300000
ETHOL_SYNC_START_DELAY_MS=120000

# Batas tunggu tombol notifikasi portal saat scraping (ms). Default 15000.
PORTAL_NOTIF_TIMEOUT_MS=15000

# Set false untuk mematikan sementara semua scraping ETHOL/portal.
# WhatsApp tetap jalan dan bisa membalas perintah.
SCRAPER_ENABLED=true

# Mode aman untuk nomor baru / masa pemanasan.
# true = hidetag manual, command media, dan cron non-absensi dimatikan.
# Notifikasi absensi otomatis TETAP jalan kalau SCRAPER_ENABLED=true.
# Bot hanya membalas command teks seperti .menu, .jadwal, .tugas.
# Menu tombol/list tetap mengikuti ENABLE_BUTTONS; matikan ENABLE_BUTTONS saat warm-up.
# Set false setelah masa warm-up selesai dan nomor terbukti stabil.
SAFE_MODE=true

# Saat SAFE_MODE=true, semua kiriman media (gambar/audio/dokumen/stiker/kontak) diblokir.
# Ini mencegah satu upload yang macet membekukan writer Baileys.
SAFE_MODE_BLOCK_MEDIA=true

# Reaksi emoji saat SAFE_MODE. Default false agar tidak menambah kiriman keluar.
SAFE_MODE_REACTIONS=false

# Batas ukuran media keluar dalam MB. 0 = tanpa batas.
MAX_OUTGOING_MEDIA_MB=16

# Batas jumlah mention per pesan hidetag. 0 = tanpa batas.
MAX_OUTGOING_MENTIONS=512

# Mode khusus absensi: hanya cek absensi otomatis + notif, tanpa briefing/reminder/SIAGA.
# Bisa dipakai bersama SAFE_MODE=true agar cron lain tetap mati.
# Wajib SCRAPER_ENABLED=true supaya pengecekan portal benar-benar jalan.
# Set false kalau ingin mengaktifkan lagi briefing/reminder/SIAGA/portal acak.
# Penting: set false hanya jika SAFE_MODE=false. Kombinasi SAFE_MODE=true +
# ATTENDANCE_ONLY=false mematikan semua cron otomatis.
ATTENDANCE_ONLY=true

# Experimental true sound sticker via Baileys WAProto wire patch (field 134).
# Needs `npm run patch-baileys` after install. Default false = .saudio sends
# a WebP sticker + separate voice note.
SOUND_STICKER_EXPERIMENTAL=false

# Sticker pack name written into WebP EXIF (pack + author).
STICKER_NAME=SmartBot by RzkyAds

# Experimental sound sticker audio limits. Sticker + audio pakai durasi sama
# (default 15 detik) supaya tidak desinkron.
STICKER_AUDIO_MAX_MB=32
STICKER_AUDIO_SECONDS=15
STICKER_AUDIO_SOUND_SECONDS=15
STICKER_MAX_BYTES=512000
SOUND_STICKER_MAX_AUDIO_BYTES=921600

# Chrome tidak akan dijalankan kalau RAM tersedia di bawah nilai ini (MB).
# Mencegah OOM di VPS kecil. Di VPS 892 MB, tambahkan swap 1 GB dulu,
# lalu 220-250 cukup aman. Jangan turunkan tanpa swap.
MIN_FREE_MEMORY_MB=300

# Kalau RAM sedang pas-pasan, Chrome menunggu hingga batas ini sebelum menyerah (ms).
# 0 = langsung gagal tanpa menunggu. Default 30000 (30 detik).
PUPPETEER_MEMORY_WAIT_MS=30000

# Interval keep-alive WhatsApp. Jangan terlalu tinggi; server WhatsApp bisa menutup koneksi idle.
WA_KEEPALIVE_MS=30000

# Batas waktu satu pengiriman pesan (ms). Kalau lewat batas, bot berhenti menunggu
# dan menganggapnya error fatal, bukan menggantung selamanya. 0 = tanpa batas.
WA_SEND_TIMEOUT_MS=180000
